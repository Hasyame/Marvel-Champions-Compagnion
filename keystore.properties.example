# Copy to keystore.properties (gitignored) and fill in.
#
# storeFile is resolved relative to the repository root. Keeping the key
# OUTSIDE the repository is safer still — an absolute path works:
#   storeFile=C:/Users/you/keys/mcc-release.jks
#
# There is no recovering this key. Lose it and no future build can ever
# update an installed copy of the app; the only way back is to uninstall,
# which erases every campaign, deck and collection setting on the device.
# Back it up somewhere that is not this machine.

storeFile=release.jks
storePassword=
keyAlias=mcc
keyPassword=
