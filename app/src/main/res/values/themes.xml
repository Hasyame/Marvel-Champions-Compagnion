<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Compose supplies the real theming; this exists so the Activity has an
      AppCompat parent, which the per-app locale delegate requires.

      The window background is night black because it is what the system paints
      between the launcher and the first Compose frame. Left at the AppCompat
      default it flashed white on every cold start, which is a poor opening for
      an app that runs dark.
    -->
    <style name="Theme.MarvelChampionsCompanion" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
