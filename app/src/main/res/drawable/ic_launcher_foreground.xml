<?xml version="1.0" encoding="utf-8"?>
<!--
  MCC on a gold starburst, with a card fan behind it.

  The acronym is the point: at launcher size a picture of cards is one more
  small graphic in a grid, while three letters are read instantly. Everything
  here is original geometry — no characters, no logos, no trade dress.

  Letters are stroked paths rather than text, because a vector drawable has no
  text element. The safe zone of an adaptive icon is the middle 66dp of 108dp,
  so MCC sits inside x,y = 24..84 and only the spikes reach past it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Card fan, peeking out behind the burst. -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-20">
        <path
            android:fillColor="#D3AF37"
            android:strokeColor="#1A1113"
            android:strokeWidth="2.5"
            android:pathData="M40,22 L68,22 A3,3 0 0 1 71,25 L71,83 A3,3 0 0 1 68,86
                             L40,86 A3,3 0 0 1 37,83 L37,25 A3,3 0 0 1 40,22 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="20">
        <path
            android:fillColor="#E30022"
            android:strokeColor="#1A1113"
            android:strokeWidth="2.5"
            android:pathData="M40,22 L68,22 A3,3 0 0 1 71,25 L71,83 A3,3 0 0 1 68,86
                             L40,86 A3,3 0 0 1 37,83 L37,25 A3,3 0 0 1 40,22 Z" />
    </group>

    <!-- Starburst, carrying the letters. -->
    <path
        android:fillColor="#FCC200"
        android:strokeColor="#1A1113"
        android:strokeWidth="2.5"
        android:pathData="M54,10 L60.6,24.3 L73.8,15.6 L73.2,31.4 L88.4,27.6 L81.1,41.6
                         L96.9,43.6 L84.6,53.5 L96.9,63.4 L81.1,65.4 L88.4,79.4
                         L73.2,75.6 L73.8,91.4 L60.6,82.7 L54,97 L47.4,82.7
                         L34.2,91.4 L34.8,75.6 L19.6,79.4 L26.9,65.4 L11.1,63.4
                         L23.4,53.5 L11.1,43.6 L26.9,41.6 L19.6,27.6 L34.8,31.4
                         L34.2,15.6 L47.4,24.3 Z" />

    <!-- M C C, stroked in ink. -->
    <group>
        <path
            android:strokeColor="#1A1113"
            android:strokeWidth="6.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M22,66 L22,42 L31,55 L40,42 L40,66" />
        <path
            android:strokeColor="#1A1113"
            android:strokeWidth="6.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M63,45 A11,11 0 1 0 63,63" />
        <path
            android:strokeColor="#1A1113"
            android:strokeWidth="6.5"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M87,45 A11,11 0 1 0 87,63" />
    </group>
</vector>
