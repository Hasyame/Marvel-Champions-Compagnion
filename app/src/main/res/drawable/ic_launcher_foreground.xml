<?xml version="1.0" encoding="utf-8"?>
<!--
  MCC on a gold roundel, with a starburst and a card fan behind it.

  The roundel is the point of the design rather than decoration: the burst
  alone has a spiky edge, so letters wide enough to read ran past a spike and
  landed in ink on the dark background. A solid disc guarantees the letters sit
  on gold wherever they fall.

  All original geometry — no characters, no logos, no trade dress. Letters are
  stroked paths because a vector drawable has no text element.

  The safe zone of an adaptive icon is the middle 66dp of 108dp. The roundel is
  radius 34 about the centre and the letters stay inside it, so nothing that
  has to be read can be cropped by a launcher mask.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Card fan, peeking out behind everything. -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-22">
        <path
            android:fillColor="#D3AF37"
            android:strokeColor="#1A1113"
            android:strokeWidth="2.5"
            android:pathData="M40,18 L68,18 A3,3 0 0 1 71,21 L71,87 A3,3 0 0 1 68,90
                             L40,90 A3,3 0 0 1 37,87 L37,21 A3,3 0 0 1 40,18 Z" />
    </group>
    <group android:pivotX="54" android:pivotY="54" android:rotation="22">
        <path
            android:fillColor="#E30022"
            android:strokeColor="#1A1113"
            android:strokeWidth="2.5"
            android:pathData="M40,18 L68,18 A3,3 0 0 1 71,21 L71,87 A3,3 0 0 1 68,90
                             L40,90 A3,3 0 0 1 37,87 L37,21 A3,3 0 0 1 40,18 Z" />
    </group>

    <!-- Starburst. -->
    <path
        android:fillColor="#FCC200"
        android:strokeColor="#1A1113"
        android:strokeWidth="2.5"
        android:pathData="M54,6 L61.1,21.4 L75.3,12.1 L74.6,29.1 L91,25 L83.1,40.1
                         L100,42.2 L86.8,52.9 L100,63.6 L83.1,65.7 L91,80.8
                         L74.6,76.7 L75.3,93.7 L61.1,84.4 L54,99.8 L46.9,84.4
                         L32.7,93.7 L33.4,76.7 L17,80.8 L24.9,65.7 L8,63.6
                         L21.2,52.9 L8,42.2 L24.9,40.1 L17,25 L33.4,29.1
                         L32.7,12.1 L46.9,21.4 Z" />

    <!-- The roundel the letters are read against. -->
    <path
        android:fillColor="#FCC200"
        android:strokeColor="#1A1113"
        android:strokeWidth="2.5"
        android:pathData="M20,54 a34,34 0 1,0 68,0 a34,34 0 1,0 -68,0 Z" />

    <!-- M C C. -->
    <group>
        <path
            android:strokeColor="#1A1113"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:strokeLineJoin="round"
            android:fillColor="#00000000"
            android:pathData="M26,66 L26,42 L34,54 L42,42 L42,66" />
        <path
            android:strokeColor="#1A1113"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M58.7,48.3 A8,8 0 1 0 58.7,59.7" />
        <path
            android:strokeColor="#1A1113"
            android:strokeWidth="6"
            android:strokeLineCap="round"
            android:fillColor="#00000000"
            android:pathData="M77.7,48.3 A8,8 0 1 0 77.7,59.7" />
    </group>
</vector>
