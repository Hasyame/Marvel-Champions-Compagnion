<?xml version="1.0" encoding="utf-8"?>
<!--
  A solid gold T over a card, on deep red.

It was a gold M — a letter belonging to somebody else, and the clearest piece
  of borrowed identity the app had. The name is Thwart now, so the letter is a
  T.

  A bar struck across the card was tried first and abandoned: under a circular
  mask the card is cropped away entirely, and what is left is a notched gold
  bar that reads as a road sign. A letterform survives the mask because it is
  the subject rather than a relationship between two shapes.

  Filled, not outlined: at 48dp a stroked glyph has almost no ink in it and
  reads as weak rather than minimal. The card behind sits one shade off the
  background, enough for depth without competing.

  Original geometry — no characters, no logos, no trade dress.

  The safe zone of an adaptive icon is the middle 66dp of 108dp. The M occupies
  x = 22..86 and y = 30..78, so a circular mask cannot bite into it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      A card behind the letter, one shade off the background. Enough to read as
      depth, not enough to fight the T for attention.
    -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-12">
        <path
            android:fillColor="#8E0011"
            android:pathData="M34,16 L74,16 A5,5 0 0 1 79,21 L79,87 A5,5 0 0 1 74,92
                             L34,92 A5,5 0 0 1 29,87 L29,21 A5,5 0 0 1 34,16 Z" />
    </group>

    <!-- The shadow the letter casts on the card, which is what gives it lift. -->
    <path
        android:fillColor="#5C0009"
        android:fillAlpha="0.55"
        android:pathData="M27,33 L87,33 L87,51 L66,51 L66,81 L48,81 L48,51 L27,51 Z" />

    <!-- T, filled. Crossbar and stem both inside the 66dp safe zone. -->
    <path
        android:fillColor="#FCC200"
        android:pathData="M24,30 L84,30 L84,48 L63,48 L63,78 L45,78 L45,48 L24,48 Z" />
</vector>
