<?xml version="1.0" encoding="utf-8"?>
<!--
  A solid gold M over a card, on deep red.

  Two earlier attempts failed for opposite reasons. The first carried three
  ideas at once — starburst, card fan and letters — and read as clutter. The
  second was three thin stroked letters, which at 48dp look spindly: an
  outlined glyph has almost no ink in it, so it reads as weak rather than
  minimal.

  A filled letterform is what gives a mark weight. One bold M, drawn as a
  single closed shape with real thickness, over a card silhouette that sits
  close enough in tone not to compete. The card says what the app is for; the M
  is what you recognise at a glance.

  Original geometry — no characters, no logos, no trade dress.

  The safe zone of an adaptive icon is the middle 66dp of 108dp. The M occupies
  x = 22..86 and y = 30..78, so a circular mask cannot bite into it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
      A card behind the letter, one shade off the background. Enough to read as
      depth, not enough to fight the M for attention.
    -->
    <group android:pivotX="54" android:pivotY="54" android:rotation="-12">
        <path
            android:fillColor="#8E0011"
            android:pathData="M34,16 L74,16 A5,5 0 0 1 79,21 L79,87 A5,5 0 0 1 74,92
                             L34,92 A5,5 0 0 1 29,87 L29,21 A5,5 0 0 1 34,16 Z" />
    </group>

    <!-- The shadow the letter casts on the card, which is what gives it lift. -->
    <path
        android:fillColor="#5C0009"
        android:fillAlpha="0.55"
        android:pathData="M25,81 L25,33 L41,33 L57,57 L73,33 L89,33 L89,81 L75,81
                         L75,55 L63,73 L51,73 L39,55 L39,81 Z" />

    <!-- M, filled. -->
    <path
        android:fillColor="#FCC200"
        android:pathData="M22,78 L22,30 L38,30 L54,54 L70,30 L86,30 L86,78 L72,78
                         L72,52 L60,70 L48,70 L36,52 L36,78 Z" />
</vector>
