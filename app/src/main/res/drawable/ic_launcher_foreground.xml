<?xml version="1.0" encoding="utf-8"?>
<!--
  A gold MCC wordmark with a rule beneath it, on deep red.

  The previous icon carried three ideas at once — a starburst, a fan of cards
  and the letters — which is why it read as cluttered at the size an icon is
  actually seen. This carries one: the name. Everything else is spacing.

  Geometry rather than a font: a vector drawable has no text element, and a
  stroked path is sharp at every density. Round caps keep it from looking
  brittle at 48dp, which is where most people will ever see it.

  Original work throughout — no characters, no logos, no trade dress.

  The safe zone of an adaptive icon is the middle 66dp of 108dp. The wordmark
  sits inside x = 24..84 and y = 40..74, so no launcher mask can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- M -->
    <path
        android:strokeColor="#FCC200"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000"
        android:pathData="M24,64 L24,40 L32,52 L40,40 L40,64" />

    <!-- C -->
    <path
        android:strokeColor="#FCC200"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M59.7,46.3 A8,8 0 1 0 59.7,57.7" />

    <!-- C -->
    <path
        android:strokeColor="#FCC200"
        android:strokeWidth="5.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000"
        android:pathData="M81.7,46.3 A8,8 0 1 0 81.7,57.7" />

    <!--
      The rule. It gives the three letters a base to sit on, which is what
      stops a short wordmark from floating in the middle of the canvas.
    -->
    <path
        android:fillColor="#FCC200"
        android:pathData="M28,71 L80,71 A1.5,1.5 0 0 1 80,74 L28,74 A1.5,1.5 0 0 1 28,71 Z" />
</vector>
