<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and above. Same policy as backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="cards.db" />
        <exclude domain="database" path="cards.db-shm" />
        <exclude domain="database" path="cards.db-wal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="cards.db" />
        <exclude domain="database" path="cards.db-shm" />
        <exclude domain="database" path="cards.db-wal" />
    </device-transfer>
</data-extraction-rules>
