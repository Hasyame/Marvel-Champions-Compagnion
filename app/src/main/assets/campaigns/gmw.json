      { "cardCode": "16177", "cost": 7, "cardListId": "purchases" }
    ]
  },

  "startScenarioId": "s1_badoon",

  "scenarios": [
    {
      "id": "s1_badoon",
      "name": { "fr": "1 — Confrérie Badoon", "en": "1 — Brotherhood of Badoon" },

      "baseSetup": {
        "villainDeck": {
          "standard": ["16058", "16059"],
          "expert": ["16059", "16060"]
        },
        "mainScheme": ["16061a", "16062a"],
        "encounterSets": [
          "brotherhood_of_badoon",
          "band_of_badoon",
          "ship_command",
          "standard"
        ]
      },

      "campaignSetup": [
        { "text": { "fr": "Révéler 16178a", "en": "Reveal 16178a" } },
        {
          "text": {
            "fr": "Mélanger 16183 dans le deck rencontre",
            "en": "Shuffle 16183 into the encounter deck"
          }
        },
        {
          "text": {
            "fr": "Étape supplémentaire en Expert — voir le livret de campagne",
            "en": "Additional Expert step — see the campaign book"
          },
          "when": { "difficulty": "expert" }
        }
      ],

      "onVictory": {
        "prompts": [
          {
            "id": "vp",
            "type": "number",
            "label": {
              "fr": "Points de victoire dans la zone de victoire",
              "en": "Victory points in the victory display"
            }
          },
          {
            "id": "noMinions",
            "type": "boolean",
            "label": { "fr": "Aucun sbire en jeu", "en": "No minions in play" }
          },
          {
            "id": "schemeAt1B",
            "type": "boolean",
            "label": { "fr": "Complot principal en 1B", "en": "Main scheme on stage 1B" }
          },
          {
            "id": "headhunterInVictoryDisplay",
            "type": "boolean",
            "label": {
              "fr": "16183 dans la zone de victoire",
              "en": "16183 in the victory display"
            }
          },
          {
            "id": "hpPerHero",
            "type": "perHeroNumber",
            "label": { "fr": "Points de vie restants", "en": "Remaining hit points" },
            "when": { "difficulty": "expert" }
          },
          {
            "id": "eliminated",
            "type": "perHeroBoolean",
            "label": { "fr": "Héros éliminé", "en": "Hero eliminated" }
          }
        ],

        "effects": [
          { "op": "addCounter", "counter": "credits", "value": 1 },
          { "op": "addCounter", "counter": "credits", "from": "vp", "max": 3 },
          {
            "op": "addCounter",
            "counter": "credits",
            "value": 1,
            "when": { "answer": "noMinions" }
          },
          {
            "op": "addCounter",
            "counter": "credits",
            "value": 1,
            "when": { "answer": "schemeAt1B" }
          },
          {
            "op": "setFlag",
            "flag": "headhunterDefeated",
            "from": "headhunterInVictoryDisplay"
          },
          {
            "op": "setHeroCounter",
            "counter": "hp",
            "from": "hpPerHero",
            "when": { "difficulty": "expert" }
          }
        ],

        "next": [{ "goto": "s2_museum" }]
      },

      "onDefeat": {
        "prompts": [],
        "effects": [],
        "next": [{ "goto": "s1_badoon" }]
      }
    },
    {
      "id": "s2_museum",
      "name": { "fr": "2 — Infiltrer le musée", "en": "2 — Infiltrate the Museum" },
      "_status": "Order confirmed. Setup, questionnaire and effects still to come.",
      "onVictory": { "next": [{ "goto": "s3_escape" }] },
      "onDefeat": { "next": [{ "goto": "s2_museum" }] }
    },
    {
      "id": "s3_escape",
      "name": { "fr": "3 — Fuir le musée", "en": "3 — Escape the Museum" },
      "_status": "Order confirmed. Setup, questionnaire and effects still to come.",
      "onVictory": { "next": [{ "goto": "s4_nebula" }] },
      "onDefeat": { "next": [{ "goto": "s3_escape" }] }
    },
    {
      "id": "s4_nebula",
      "name": { "fr": "4 — Nebula", "en": "4 — Nebula" },
      "_status": "Order confirmed. Setup, questionnaire and effects still to come.",
      "onVictory": { "next": [{ "goto": "s5_ronan" }] },
      "onDefeat": { "next": [{ "goto": "s4_nebula" }] }
    },
    {
      "id": "s5_ronan",
      "name": { "fr": "5 — Ronan l'Accusateur", "en": "5 — Ronan the Accuser" },
      "_status": "Order confirmed. Setup, questionnaire and effects still to come.",
      "onVictory": { "next": [{ "end": true }] },
      "onDefeat": { "next": [{ "goto": "s5_ronan" }] }
    }
  ]
}
