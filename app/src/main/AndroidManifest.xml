<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      allowBackup is off on purpose. Android auto-backup copies app data to the
      user's Google Drive, which would include the play history, the campaign
      log and the encrypted BoardGameGeek blob — and this app promises that what
      it stores stays on the device. Settings offers an explicit backup the
      player asks for and keeps themselves, which is the honest version of the
      same feature.
    -->
    <application
        android:name=".MarvelChampionsApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MarvelChampionsCompanion"
        tools:targetApi="33">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.MarvelChampionsCompanion">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Share target. A browser sharing a marvelcdb.com page sends plain
              text, so the link is pulled out of whatever text arrives.
            -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>

            <!--
              Opening a marvelcdb.com deck link directly. Not autoVerify: that
              would need a Digital Asset Links file hosted on marvelcdb.com,
              which is not ours, so Android shows the app chooser instead.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <!--
                  Attributes combine as a cross product, so these separate tags
                  cover every host and path pair.
                -->
                <data android:scheme="https" />
                <data android:host="marvelcdb.com" />
                <data android:host="www.marvelcdb.com" />
                <data android:host="fr.marvelcdb.com" />
                <data android:pathPrefix="/decklist/view" />
                <data android:pathPrefix="/deck/view" />
            </intent-filter>
        </activity>

        <!--
          WorkManager is configured on demand from MarvelChampionsApplication so
          that Hilt can build CardSyncWorker; its default initializer has to go.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
