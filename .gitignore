# Card data seed. Generated by `./gradlew fetchCardSeed` from the MarvelCDB API.
# Never committed: it is Fantasy Flight's card text (see README, Legal).
/app/src/main/assets/seed/

# Campaign templates in app/src/main/assets/campaigns/ ARE committed. They hold
# mechanics only — card codes, counters, conditions, effects — and no rules or
# flavour text from the campaign book. See README, Legal.
#
# A personal template holding book text should be named *.campaign.json, which
# stays ignored.
*.campaign.json
